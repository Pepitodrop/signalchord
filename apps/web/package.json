    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
